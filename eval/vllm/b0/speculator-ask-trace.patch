+# --- debug instrumentation: file-flag gated (/tmp/dflash_trace.on), jsonl out ---
+_DF_TRACE_FH = None  # None=unchecked, False=off, else open file
+
+
+def _df_trace(ev: dict) -> None:
+    global _DF_TRACE_FH
+    if _DF_TRACE_FH is None:
+        _DF_TRACE_FH = (
+            open("/tmp/dflash_trace.jsonl", "a", buffering=1)
+            if os.path.exists("/tmp/dflash_trace.on")
+            else False
+        )
+    if _DF_TRACE_FH:
+        ev["t"] = round(time.time(), 3)
+        _DF_TRACE_FH.write(json.dumps(ev) + "\n")
+
+
+# ---- B0 ask-level dump: bf16 双侧数值复刻的金标准采集 ----
+# 门: /tmp/dflash_ask.on。每步两条记录:
+#   in  (propose 入口): aux_hidden_states 拼接(fc 输入, num_tokens×25600) + 本步输入 token
+#   out (_generate_draft 出口): fc 输出(self.hidden_states)、drafter 5 层输出(sample hidden)、
+#       candidate top-16、unary、sanitized scores、selector 选中路径、anchor token
+# 注意: 须 --enforce-eager——FULL cudagraph 下 _generate_draft 被捕获, Python 只在捕获期执行一次。
+_ASK = {"steps": [], "n": 0, "max_steps": 600}
+
+
+def _ask_on() -> bool:
+    return os.path.exists("/tmp/dflash_ask.on")
+
+
+def _ask_add(rec: dict) -> None:
+    if len(_ASK["steps"]) >= _ASK["max_steps"]:
+        return
+    _ASK["steps"].append(rec)
+    if len(_ASK["steps"]) >= 40:
+        _ask_flush()
+
+
+def _ask_flush() -> None:
+    if not _ASK["steps"]:
+        return
+    torch.save(_ASK["steps"], "/tmp/dflash_ask-%04d.pt" % _ASK["n"])
+    _ASK["n"] += 1
+    _ASK["steps"] = []
+
