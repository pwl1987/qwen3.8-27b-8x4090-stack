# B0: bf16-drafter 双侧数值复刻沙箱（GPU2 :19627，zx-p0 overlay）
# 基线=认证 130 配置；单变量: DRAFT→bf16 目录 + --enforce-eager（trace 需逐步 Python 执行，
# FULL cudagraph 下 _generate_draft 被捕获，Python dump 不会在重放期执行）
PORT=19627
HOST=0.0.0.0
MODEL=/app/models/coding-v1.1-W4A16
SPEC=dflash2
DFLASH_TOKENS=7
PREFIX_CACHE=1
VISION=1
VISION_OFFLOAD=1
CTX=huge
MAX_SEQS=1
GPU_UTIL=0.95
REQ_METRICS=1
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1
HF_ENDPOINT=https://hf-mirror.com
EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3 --enforce-eager
MAX_LEN=32768
DFLASH_MAX_LEN=32768
DRAFT=/app/models/Qwen3.8-27B-DFlash2
LOOKUP=0
KV_MEM=2000000000
VLLM_V2_CUDAGRAPH_MEM_MIB=1000
